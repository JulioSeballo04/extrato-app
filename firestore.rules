rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Cada usuário lê e escreve no próprio documento (users/{uid}). Quem tem
    // um vínculo com ele em `links` pode apenas LER — nunca escrever.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (
        exists(/databases/$(database)/documents/links/$(uid + '_' + request.auth.uid)) ||
        exists(/databases/$(database)/documents/links/$(request.auth.uid + '_' + uid))
      );
    }

    // Convites: código aleatório gerado por quem quer vincular. Só dá para
    // buscar um convite pelo código exato (não há listagem).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn();
    }

    // Vínculo entre dois usuários. O id é `uidA_uidB` (uids em ordem
    // alfabética) e só pode ser criado por quem apresenta um convite válido
    // (não expirado) do outro membro.
    match /links/{linkId} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && linkId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.owner in request.resource.data.members
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.owner != request.auth.uid
        && request.time < get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.expiresAt;
    }
  }
}
