rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só pode ler e escrever no próprio documento (users/{uid}),
    // isolando completamente os dados entre contas diferentes.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
